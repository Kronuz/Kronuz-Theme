{
	"name": "Kronuz Light",
	"author": "Germán Méndez Bravo (Kronuz)",
	"variables": {
		"background": "#fafafa",
		"foreground": "#3a3837",
		"dim": "#8a8785",
		"soft": "#6b6865",
		"caret": "#c46608",
		"comment": "#8e713e",
		"string": "#67871c",
		"number": "#67871c",
		"regexp": "#7a9113",
		"escape": "#bc6010",
		"keyword": "#bc5e10",
		"func": "#a57207",
		"type": "#c41b08",
		"cls": "#895a06",
		"tag": "#a06921",
		"vari": "#2b2826",
		"param": "#896106dd",
		"lang": "#060689",
		"constLang": "#2b6fa1",
		"raw": "#8a1768",
		"link": "#2e659e",
		"heading": "#c46e08",
		"mdBold": "#2064ac",
		"mdItalic": "#205994",
		"list": "#7c8b18",
		"ins": "#0a998b",
		"del": "#c40b08",
		"chg": "#c43f08",
		"invalid": "#c41008"
	},
	"globals": {
		"background": "var(background)",
		"foreground": "var(foreground)",
		"caret": "var(caret)",
		"block_caret": "var(caret)",
		"line_highlight": "#9f9f9f80",
		"selection": "#0837c466",
		"selection_border": "var(background)",
		"inactive_selection": "#9ea2a880",
		"misspelling": "var(del)",
		"highlight": "var(link)",
		"find_highlight": "var(keyword)",
		"find_highlight_foreground": "var(background)",
		"gutter": "var(background)",
		"gutter_foreground": "var(dim)",
		"guide": "#29292906",
		"active_guide": "var(caret)",
		"stack_guide": "#68683c",
		"brackets_foreground": "var(keyword)",
		"brackets_options": "underline",
		"bracket_contents_foreground": "var(keyword)",
		"bracket_contents_options": "underline",
		"tags_foreground": "var(tag)",
		"tags_options": "stippled_underline",
		"invisibles": "#29292908",
		"shadow": "hsla(0, 0%, 0%, 0.12)"
	},
	"rules": [
		{
			"scope": "string source",
			"foreground": "var(escape)"
		},
		{
			"scope": "support",
			"foreground": "var(type)"
		},
		{
			"scope": "variable.parameter",
			"foreground": "var(param)",
			"font_style": "italic"
		},
		{
			"scope": "entity.name.tag",
			"foreground": "var(tag)"
		},
		{
			"scope": "variable.other, variable.js, punctuation.separator.variable",
			"foreground": "var(vari)"
		},
		{
			"scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
			"foreground": "var(string)"
		},
		{
			"scope": "invalid",
			"foreground": "var(invalid)"
		},
		{
			"scope": "variable.other.php, variable.other.normal",
			"foreground": "var(vari)"
		},
		{
			"scope": "meta.tag",
			"foreground": "var(foreground)"
		},
		{
			"scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
			"foreground": "var(list)"
		},
		{
			"scope": "meta.tag.inline source, text.html.php.source",
			"foreground": "var(list)"
		},
		{
			"scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
			"foreground": "var(tag)"
		},
		{
			"scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
			"foreground": "var(vari)"
		},
		{
			"scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
			"foreground": "var(link)"
		},
		{
			"scope": "meta.toc-list.id",
			"foreground": "var(list)"
		},
		{
			"scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html",
			"foreground": "var(list)"
		},
		{
			"scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
			"foreground": "var(func)"
		},
		{
			"scope": "source.css entity.other.attribute-name",
			"foreground": "var(tag)"
		},
		{
			"scope": "support.type.property-name.css",
			"foreground": "var(vari)"
		},
		{
			"scope": "meta.property-group support.constant.property-value.css, meta.property-value support.constant.property-value.css",
			"foreground": "var(type)"
		},
		{
			"scope": "variable.language.js",
			"foreground": "var(lang)"
		},
		{
			"scope": "punctuation.definition.template-expression, punctuation.section.embedded.coffee",
			"foreground": "var(escape)"
		},
		{
			"scope": "meta.template.expression",
			"foreground": "var(foreground)"
		},
		{
			"scope": "meta.function-call.object.php",
			"foreground": "var(func)"
		},
		{
			"scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
			"foreground": "var(list)"
		},
		{
			"scope": "source.php.embedded.line.html",
			"foreground": "var(dim)"
		},
		{
			"scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
			"foreground": "var(escape)"
		},
		{
			"scope": "constant.other.symbol.ruby",
			"foreground": "var(list)"
		},
		{
			"scope": "variable.language.ruby",
			"foreground": "var(lang)"
		},
		{
			"scope": "keyword.other.special-method.ruby",
			"foreground": "var(keyword)"
		},
		{
			"scope": "punctuation.section.embedded.begin.ruby, punctuation.section.embedded.end.ruby",
			"foreground": "var(escape)"
		},
		{
			"scope": "keyword.other.DML.sql",
			"foreground": "var(func)"
		},
		{
			"scope": "meta.diff, meta.diff.header",
			"foreground": "var(soft)",
			"font_style": "italic"
		},
		{
			"scope": "markup.deleted",
			"foreground": "var(del)"
		},
		{
			"scope": "markup.changed",
			"foreground": "var(chg)"
		},
		{
			"scope": "markup.inserted",
			"foreground": "var(ins)"
		},
		{
			"scope": "markup.quote",
			"foreground": "var(tag)"
		},
		{
			"scope": "markup.list",
			"foreground": "var(list)"
		},
		{
			"scope": "markup.bold",
			"foreground": "var(mdBold)",
			"font_style": "bold"
		},
		{
			"scope": "markup.italic",
			"foreground": "var(mdItalic)",
			"font_style": "italic"
		},
		{
			"scope": "markup.inline.raw",
			"foreground": "var(raw)"
		},
		{
			"scope": "markup.heading",
			"foreground": "var(heading)"
		},
		{
			"scope": "markup.heading.setext",
			"foreground": "var(heading)"
		},
		{
			"scope": "markup.underline",
			"foreground": "var(list)"
		},
		{
			"scope": "string.other.link.title.markdown",
			"foreground": "var(constLang)"
		},
		{
			"scope": "token.info-token",
			"foreground": "var(link)"
		},
		{
			"scope": "token.warn-token",
			"foreground": "var(keyword)"
		},
		{
			"scope": "token.error-token",
			"foreground": "var(del)"
		},
		{
			"scope": "token.debug-token",
			"foreground": "var(raw)"
		},
		{
			"scope": "variable.language",
			"foreground": "var(lang)"
		},
		{
			"scope": "keyword",
			"foreground": "var(keyword)"
		},
		{
			"scope": "keyword.control",
			"foreground": "var(keyword)"
		},
		{
			"scope": "storage",
			"foreground": "var(keyword)"
		},
		{
			"scope": "constant.numeric",
			"foreground": "var(number)"
		},
		{
			"scope": "entity.name.type",
			"foreground": "var(type)"
		},
		{
			"scope": "support.type",
			"foreground": "var(type)",
			"font_style": "italic"
		},
		{
			"scope": "support.class",
			"foreground": "var(func)",
			"font_style": "italic"
		},
		{
			"scope": "entity.name.function",
			"foreground": "var(func)"
		},
		{
			"scope": "meta.function-call.generic, meta.function-call.object",
			"foreground": "var(func)"
		},
		{
			"scope": "variable.other.property",
			"foreground": "var(func)"
		},
		{
			"scope": "support.function",
			"foreground": "var(func)",
			"font_style": "italic"
		},
		{
			"scope": "variable",
			"foreground": "var(vari)"
		},
		{
			"scope": "comment",
			"foreground": "var(comment)",
			"font_style": "italic"
		},
		{
			"scope": "constant.character, constant.language, constant.other.character-class",
			"foreground": "var(constLang)"
		},
		{
			"scope": "",
			"foreground": "var(vari)",
			"font_style": "italic"
		},
		{
			"scope": "string, string.quoted.single",
			"foreground": "var(string)"
		},
		{
			"scope": "string.quoted.double, string.quoted.multi",
			"foreground": "#77722c"
		},
		{
			"scope": "string.regexp.quoted",
			"foreground": "var(regexp)"
		},
		{
			"scope": "string.quoted.docstring",
			"foreground": "var(comment)"
		},
		{
			"scope": "entity.name.type, entity.name.class",
			"foreground": "var(cls)"
		},
		{
			"scope": "entity.other.inherited-class",
			"foreground": "var(tag)",
			"font_style": "italic"
		},
		{
			"scope": "punctuation.definition.comment",
			"foreground": "var(comment)",
			"font_style": "italic"
		},
		{
			"scope": "meta.string",
			"foreground": "var(string)"
		},
		{
			"scope": "constant.other.placeholder",
			"foreground": "var(escape)"
		},
		{
			"scope": "constant.other, punctuation.accessor",
			"foreground": "var(keyword)"
		},
		{
			"scope": "entity.name.namespace",
			"foreground": "var(type)"
		},
		{
			"scope": "punctuation.definition.tag",
			"foreground": "var(tag)"
		},
		{
			"scope": "support.type.property-name, meta.object-literal.key, meta.definition.variable",
			"foreground": "var(vari)"
		},
		{
			"scope": "meta.decorator, punctuation.decorator, entity.name.label",
			"foreground": "var(func)"
		},
		{
			"scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
			"foreground": "var(foreground)"
		},
		{
			"scope": "entity.name.section",
			"foreground": "var(heading)",
			"font_style": "bold"
		},
		{
			"scope": "markup.link",
			"foreground": "var(link)",
			"font_style": "underline"
		},
		{
			"scope": "markup.raw.inline, markup.raw, markup.fenced_code",
			"foreground": "var(raw)"
		}
	]
}
